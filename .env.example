# Copy to .env and fill in. Never commit the real .env file.

# Timezone the pipeline reasons about "9 AM" in. Must handle DST correctly (see README).
TZ=America/Chicago

# Composio — connected to Discord (read), Pinterest (search), Instagram (publish)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Discord channel the Grok scraper posts articles into (#underground-news)
DISCORD_HEAT_CHANNEL_ID=

# Instagram business account id (via Composio)
IG_USER_ID=

# Pinterest board to search for artist/producer photos (via Composio)
PINTEREST_BOARD_ID=

# Google Gemini — free tier, article classification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Genius — free API, lyric line + annotation lookup for diss posts
GENIUS_ACCESS_TOKEN=

# Google Custom Search JSON API — free tier, fallback image search
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# Google Sheets — log of previously-posted articles
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Sheet1

# Set to 1 to actually publish to Instagram. Keep at 0 until the pipeline is fully built and tested.
CAROUSEL_PUBLISH=0
