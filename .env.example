# Copy to .env and fill in. Never commit the real .env file.

# Timezone the pipeline reasons about "9 AM" in. Must handle DST correctly (see README).
TZ=America/Chicago

# Composio — project API key (Settings > Project Settings > API Keys), NOT
# the "Sessions & API Key" MCP-client key and NOT a personal login session —
# neither of those authenticate direct tool-execution calls.
COMPOSIO_API_KEY=
# Arbitrary identifier for the entity that owns the connected accounts below
# (any string is fine — it's just a namespace Composio scopes connections to).
COMPOSIO_USER_ID=

# Discord channel the Grok scraper posts articles into (#underground-news)
DISCORD_HEAT_CHANNEL_ID=
# Connected account id for Discord under this project (from POST
# /api/v3/connected_accounts/link with the discordbot auth config) — the
# project's own connected accounts, not whatever's connected on the personal
# dashboard/login, since project API keys can't see those.
COMPOSIO_DISCORD_ACCOUNT_ID=

# Instagram business account id (via Composio) — the account must be an
# Instagram Business/Creator account linked to a Facebook Page. Get this via
# INSTAGRAM_GET_USER_INFO after connecting.
IG_USER_ID=
# Connected account id for Instagram under this project (same pattern as
# COMPOSIO_DISCORD_ACCOUNT_ID above).
COMPOSIO_INSTAGRAM_ACCOUNT_ID=

# Pinterest — Composio search over the connected account's OWN pins only
# (Pinterest's API has no general public search, and Google Custom Search
# is no longer usable as an open-web fallback — Google discontinued free
# "search the entire web" for new engines in March 2026). Reference photos
# of artists/producers need to actually be pinned to this account, or the
# candidate gets skipped in favor of the next-newest one.
# Connected account id under this project (same pattern as
# COMPOSIO_DISCORD_ACCOUNT_ID above).
COMPOSIO_PINTEREST_ACCOUNT_ID=

# Facebook — cross-posts the daily carousel's cover slide + caption to the
# "808 Dystopia" Page, right after the same content goes to Instagram.
# Only supports Facebook Pages, not personal profiles.
# Connected account id under this project (same pattern as
# COMPOSIO_DISCORD_ACCOUNT_ID above).
COMPOSIO_FACEBOOK_ACCOUNT_ID=
# The "808 Dystopia" Facebook Page id -- already known and defaulted in
# src/config.js (found via a live FACEBOOK_LIST_MANAGED_PAGES call), only
# override if a different Page should be used. Not the connected
# account's own user id -- that identifies the person managing the Page,
# not the Page itself.
FACEBOOK_PAGE_ID=1326786480516977

# Set to 1 to actually cross-post the carousel to Facebook. Keep at 0
# until tested (same posture as the other publish gates).
FACEBOOK_CROSSPOST_PUBLISH=0

# Same idea, for cross-posting the daily Reel's clip + caption to the
# same Facebook Page -- independent gate since it's a separate (video)
# code path that needs its own live validation.
REEL_FACEBOOK_CROSSPOST_PUBLISH=0

# DeepSeek — pay-as-you-go, article classification. platform.deepseek.com ->
# sign up -> API Keys -> create key, then add a small prepaid balance under
# Billing to activate it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Genius — free API, lyric line + annotation lookup for diss posts
GENIUS_ACCESS_TOKEN=

# Spotify — Client Credentials flow (no user login), authoritative tracklist
# for album_drop posts. Free API, but creating the developer app itself
# currently requires the app owner's account to have Spotify Premium.
# developer.spotify.com/dashboard -> Create app -> Client ID + Client Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# Google Sheets — log of previously-posted articles
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=News
# Connected account id for Google Sheets under this project (same pattern as
# COMPOSIO_DISCORD_ACCOUNT_ID above).
COMPOSIO_GOOGLESHEETS_ACCOUNT_ID=

# Set to 1 to actually publish to Instagram. Keep at 0 until the pipeline is fully built and tested.
CAROUSEL_PUBLISH=0


# ============================================================
# Reel pipeline (Phase 2) — separate automation, same repo/Discord/
# Instagram/Sheets, posts a daily history Reel ahead of 7 PM CT.
# ============================================================

# Discord channel where reel content requests are posted, one per line,
# "Artist — content type" (e.g. "Pierre Bourne — beat breakdown").
# Reuses the same Composio Discord connected account as the news
# pipeline (COMPOSIO_DISCORD_ACCOUNT_ID above) — just a different channel.
DISCORD_REELS_CHANNEL_ID=

# YouTube Data API v3 — video search + status/detail checks (finding and
# vetting a candidate video, NOT downloading it — see YOUTUBE_COOKIES below
# for that). console.cloud.google.com -> enable "YouTube Data API v3" ->
# Credentials -> API key. Free tier: 10,000 quota units/day (search.list
# costs 100/call) — plenty for one request/day.
# NOTE: no third-party video's transcript/captions are reachable through
# this API or any free/unofficial route — validated live (see
# src/clients/youtube.js). The pipeline transcribes the downloaded video
# locally with Whisper instead (src/clients/whisper.js).
YOUTUBE_API_KEY=

# Cookies from a REAL, LOGGED-IN Google account, in Netscape cookies.txt
# format — required to actually download a video/audio file with yt-dlp.
# Validated live: every cookie-less download approach (default client,
# forcing a JS runtime, the "tv" client) gets blocked by YouTube's bot
# detection on datacenter IPs, which is exactly what GitHub Actions runners
# are. This is the standard real-world fix for that, not a fragile trick —
# but expect to need to redo this export every so often when the cookies
# expire (weeks to months), since there's no way to refresh them
# unattended. Recommend a secondary/throwaway Google account, not a
# personal one, since this becomes a long-lived CI secret.
# How to export: log into YouTube in a real browser with that account,
# then use a "cookies.txt" export extension (e.g. "Get cookies.txt
# LOCALLY" for Chrome/Firefox) while on youtube.com, or run
# `yt-dlp --cookies-from-browser <browser> --cookies cookies.txt
# https://www.youtube.com` locally.
# NOTE: a whole-browser cookies.txt export (as opposed to one scoped to
# youtube.com specifically) can carry cookies for hundreds of unrelated
# sites the browser happened to have open tabs/history for — confirmed
# live, one real export came out to 3,666 lines across ad networks and
# entirely unrelated logged-in accounts. Filter it down to just
# youtube.com / google.com / accounts.google.com lines (keep the header
# comment lines too) before using it — this is the only scope yt-dlp
# actually needs, and it keeps a much smaller, less sensitive blob as a
# long-lived CI secret.
#
# THIS VALUE MUST BE BASE64-ENCODED, not the raw file — confirmed live
# that pasting the raw multi-line cookies.txt content through a text
# editor and into GitHub's secret box silently mangled it: tabs between
# cookie fields became non-breaking spaces, corrupting exactly the
# session-auth cookies that make authenticated download work at all
# (yt-dlp then fails with the same "sign in to confirm you're not a bot"
# error as having no cookies whatsoever, with no obvious reason why).
# Base64 is plain alphanumeric text, immune to that. Encode with:
#   base64 -w0 cookies.txt          (Linux)
#   base64 -i cookies.txt           (macOS)
# then paste that single-line output as the secret's value.
YOUTUBE_COOKIES=

# Twitch — secondary video source, tried when YouTube yields nothing
# usable for an artist (see src/clients/twitch.js). Free: an App Access
# Token (Client Credentials flow, no user login) is enough for the
# read-only endpoints this uses (search channels, get clips).
# dev.twitch.tv/console -> Register Your Application (any name; OAuth
# Redirect URL can be http://localhost since this flow never uses it;
# Category: anything, e.g. "Application Integration") -> Manage -> copy
# the Client ID, then click "New Secret" for the Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Separate tab in the same Sheet (GOOGLE_SHEETS_ID above) for reel dedup
# logging, so a used clip is never reposted.
GOOGLE_SHEETS_REELS_TAB=Reels

# Set to 1 to actually publish Reels. Keep at 0 until this pipeline is
# fully built and tested (same posture as CAROUSEL_PUBLISH). Independent
# of that flag — the two pipelines can go live separately.
REEL_PUBLISH=0


# ============================================================
# EOD Brief — separate automation, posts a daily business summary
# (accomplishments, Instagram analytics, recommendations) to the private
# #admin-general channel ahead of 9 PM CT. Reuses the same Composio
# Discord/Instagram connected accounts and DeepSeek key as the other two
# pipelines above.
# ============================================================

# #admin-general in the 808 Dystopia Discord — found directly via a live
# Composio call rather than needing to be looked up manually; only
# override this if that channel is ever recreated with a new ID.
DISCORD_ADMIN_CHANNEL_ID=1542355862079807509

# GitHub token — source of the "accomplishments" section (today's merged
# PRs). In GitHub Actions this is provided automatically by the workflow
# itself (see .github/workflows/eod-brief.yml) — nothing to set up. Only
# needed here for local testing, where a personal access token with
# read access to this repo works.
GITHUB_TOKEN=
GITHUB_REPO=808dystonia/808dystopia-core

# Set to 1 to actually post the brief to Discord. Keep at 0 until tested
# (same posture as CAROUSEL_PUBLISH/REEL_PUBLISH) — lower stakes here
# since it posts to a private admin channel, not a public account, but
# kept consistent.
EOD_BRIEF_PUBLISH=0


# ============================================================
# News Brief — separate automation, posts an underground rap news digest
# to #underground-news at 12 PM and 6 PM CT, complementing (not
# replacing) the existing morning Grok-native scheduled task. No new
# credentials needed at all: RSS feeds require no API key, and this
# reuses the same DISCORD_HEAT_CHANNEL_ID / Composio Discord account /
# DeepSeek key already configured above.
# ============================================================

# Set to 1 to actually post the digest to Discord. Keep at 0 until tested
# (same posture as the other publish gates).
NEWS_BRIEF_PUBLISH=0


# ============================================================
# Site Sync — mirrors the morning/midday/night news onto 808dystopia.win's
# three news boxes (Netlify site). The News Brief pipeline above syncs its
# own Midday/Night runs; a separate morning-sync pipeline (10 AM CT)
# mirrors Grok's morning drop, since that's not code this repo controls.
# Neither pipeline redeploys the site -- both just write to a Netlify
# Blobs store the site's own "/api/news" function reads from.
# ============================================================

# A Netlify personal access token with access to the 808-dystopia site --
# app.netlify.com -> User settings -> Applications -> New access token.
# Needed because these pipelines write to Netlify Blobs from outside
# Netlify's own runtime (a GitHub Actions job), which requires an explicit
# token rather than the auto-provisioned config a Netlify Function itself
# gets for free.
NETLIFY_AUTH_TOKEN=
# The 808-dystopia Netlify site's project id -- already known and
# defaulted in src/config.js, only override if the site is ever recreated.
NETLIFY_SITE_ID=f809ce21-5a80-4332-83df-3cf7a5752c30

# Set to 1 to actually write to the site's news store. Keep at 0 until
# tested (same posture as the other publish gates) -- independent of
# NEWS_BRIEF_PUBLISH, since that one gates the Discord post, not this.
SITE_SYNC_PUBLISH=0


# ============================================================
# Pin Post — separate automation, pins underground rap/producer album
# cover art to the "Underground Hiphop album cover art" Pinterest board,
# 3x/day (9 AM/1 PM/5 PM CT), crediting the artist in the description. No
# new credentials needed at all: reuses the same Composio Discord/
# Pinterest/Sheets accounts and Spotify keys already configured above.
# Artists come from the #reels watchlist (same one the Reel pipeline
# reads) rather than a separate list to maintain.
# ============================================================

# Separate tab in the same Sheet (GOOGLE_SHEETS_ID above) for pin dedup
# logging, so the same album is never pinned twice. Create this tab with
# header row: timestamp | artist | album | pinId | status | note
GOOGLE_SHEETS_PINS_TAB=Pins

# "Underground Hiphop album cover art" board id on the connected Pinterest
# account -- already known and defaulted in src/config.js, only override
# if a different board should be used.
PINTEREST_BOARD_ID=1099230290240885517

# Set to 1 to actually pin to Pinterest. Keep at 0 until tested (same
# posture as the other publish gates).
PIN_PUBLISH=0
