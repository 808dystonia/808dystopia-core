# Copy to .env and fill in. Never commit the real .env file.

# Timezone the pipeline reasons about "9 AM" in. Must handle DST correctly (see README).
TZ=America/Chicago

# Composio — project API key (Settings > Project Settings > API Keys), NOT
# the "Sessions & API Key" MCP-client key and NOT a personal login session —
# neither of those authenticate direct tool-execution calls.
COMPOSIO_API_KEY=
# Arbitrary identifier for the entity that owns the connected accounts below
# (any string is fine — it's just a namespace Composio scopes connections to).
COMPOSIO_USER_ID=

# Discord channel the Grok scraper posts articles into (#underground-news)
DISCORD_HEAT_CHANNEL_ID=
# Connected account id for Discord under this project (from POST
# /api/v3/connected_accounts/link with the discordbot auth config) — the
# project's own connected accounts, not whatever's connected on the personal
# dashboard/login, since project API keys can't see those.
COMPOSIO_DISCORD_ACCOUNT_ID=

# Instagram business account id (via Composio)
IG_USER_ID=

# Pinterest board to search for artist/producer photos (via Composio)
PINTEREST_BOARD_ID=

# Google Gemini — free tier, article classification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Genius — free API, lyric line + annotation lookup for diss posts
GENIUS_ACCESS_TOKEN=

# Google Custom Search JSON API — free tier, fallback image search
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# Google Sheets — log of previously-posted articles
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Sheet1
# Connected account id for Google Sheets under this project (same pattern as
# COMPOSIO_DISCORD_ACCOUNT_ID above).
COMPOSIO_GOOGLESHEETS_ACCOUNT_ID=

# Set to 1 to actually publish to Instagram. Keep at 0 until the pipeline is fully built and tested.
CAROUSEL_PUBLISH=0
